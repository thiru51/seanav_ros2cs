<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable><AssemblyName>ActionDemo</AssemblyName><NoWarn>1591;1573</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/SeaNav.Ros2/SeaNav.Ros2.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(SeaNavCore)' != ''">
    <Compile Include="$(SeaNavCore)/Ros/Cdr.cs" Link="Cdr.cs" />
    <Compile Include="$(SeaNavCore)/Ros/RosMessages.cs" Link="RosMessages.cs" />
    <Compile Include="$(SeaNavCore)/Ros2Messages/*.cs" Link="Generated/%(Filename).cs" />
    <Compile Include="$(Ros2Unity)/Runtime/Ros2ParameterCodec.cs" Link="Ros2ParameterCodec.cs" />
    <Compile Include="$(Ros2Unity)/Runtime/Ros2ActionCodec.cs" Link="Ros2ActionCodec.cs" />
  </ItemGroup>
</Project>
