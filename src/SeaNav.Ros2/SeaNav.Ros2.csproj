<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 so that Unity and .NET load the same assembly. Unity's
         scripting runtime does not have System.Runtime.InteropServices.NativeLibrary,
         which is why Native/NativeLoader.cs does its own dlopen/LoadLibrary. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>SeaNav.Ros2</AssemblyName>
    <RootNamespace>SeaNav.Ros2</RootNamespace>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>1591;1574</NoWarn>
  </PropertyGroup>

  <!-- Deliberately no reference to SEANAV's CDR encoder.

       This library only ever deals in byte[] - you hand Publish() the encoded
       bytes and TryTake() hands them back. It does not need to know what a
       message is, and keeping it that way matters for Unity.

       An earlier version compiled SEANAV's Cdr.cs and RosMessages.cs into this
       assembly so the examples could use them. Inside Unity that was a disaster:
       Unity compiles those same files from Assets/SEANAV/Core/Runtime/Ros, so
       every message type existed twice and the editor filled with CS0433
       "the type exists in both" errors.

       The examples pull the CDR sources in themselves instead. -->

</Project>
